# The arbiter pressed "Download and install" on the page: the program,
# which is not root and cannot replace itself, wrote the version it wants
# into this file. That is all it can do; polis-update.service does the rest.

[Unit]
Description=Polis - an update was asked for on the page

[Path]
PathExists=/var/lib/polis/update/request
Unit=polis-update.service

[Install]
WantedBy=multi-user.target
