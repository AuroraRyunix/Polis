/*
 * Resources of Polis.exe, compiled by `zig rc` from build_launcher.ps1.
 *
 * launcher_version.h is written by that script from the version in mix.exs
 * and is not committed.
 */

#include "launcher_version.h"

1 ICON "Polis.ico"

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION POLIS_VER_MAJOR, POLIS_VER_MINOR, POLIS_VER_PATCH, 0
PRODUCTVERSION POLIS_VER_MAJOR, POLIS_VER_MINOR, POLIS_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Polis"
            VALUE "FileDescription", "Polis - the print station of a chess hall"
            VALUE "FileVersion", POLIS_VER_STRING
            VALUE "InternalName", "Polis"
            VALUE "OriginalFilename", "Polis.exe"
            VALUE "ProductName", "Polis"
            VALUE "ProductVersion", POLIS_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
